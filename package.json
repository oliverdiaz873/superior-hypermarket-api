{
  "name": "superior-hypermarket-api",
  "version": "1.0.0",
  "description": "Backend del hypermarket con arquitectura basada en features (Feature-Based Architecture)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "lint": "node scripts/eslint-check.mjs",
    "format:check": "node scripts/format-check.js",
    "start": "node dist/server.js",
    "seed": "tsx src/database/seed.ts",
    "seed:storage": "tsx scripts/seed-storage.ts",
    "clear": "tsx src/database/clear.ts",
    "clear:seed": "npm run clear && npm run seed",
    "sync:i18n": "tsx scripts/sync-i18n.ts",
    "migrate": "tsx src/database/migrate.ts up",
    "migrate:down": "tsx src/database/migrate.ts down",
    "cleanup:orphans": "tsx scripts/orphan-cleanup.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:unit": "jest --selectProjects unit --passWithNoTests",
    "test:integration": "jest --selectProjects integration --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverdiaz873/superior-hypermarket-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/oliverdiaz873/superior-hypermarket-api/issues"
  },
  "homepage": "https://github.com/oliverdiaz873/superior-hypermarket-api#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
